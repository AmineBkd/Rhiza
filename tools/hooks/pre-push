#!/bin/sh
# CI's format check, run on every commit being pushed, so uncommitted edits never block a push.

python=$(command -v python || command -v python3)
if [ -z "$python" ]; then
    echo "pre-push: python not found, skipping the format check" >&2
    exit 0
fi

failed=0
while read -r localRef localSha remoteRef remoteSha; do
    case $localSha in
        *[!0]*) ;;
        *) continue ;; # a deleted branch: nothing to check
    esac

    # A new branch, or a remote tip this clone hasn't fetched: whatever no remote has yet.
    if git cat-file -e "$remoteSha^{commit}" 2>/dev/null; then
        commits=$(git rev-list "$remoteSha..$localSha")
    else
        commits=$(git rev-list "$localSha" --not --remotes)
    fi

    for commit in $commits; do
        if ! "$python" tools/format.py --check --rev "$commit" --changed; then
            echo "pre-push: in $(git log -1 --format='%h %s' "$commit")" >&2
            failed=1
        fi
    done
done

if [ $failed -ne 0 ]; then
    echo "pre-push: unformatted code - run 'python tools/format.py', commit, push again" >&2
fi
exit $failed
