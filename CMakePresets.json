{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "windows",
      "displayName": "Windows (x64, dynamic)",
      "description": "Default vcpkg triplet (x64-windows) is already dynamic.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux (x64, dynamic)",
      "description": "vcpkg's default x64-linux triplet is static; ogre-next's D3D11-style runtime plugin loading needs dynamic libraries instead, so this pins the community x64-linux-dynamic triplet.",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS (Apple Silicon, dynamic)",
      "description": "vcpkg's default arm64-osx triplet is static; same reasoning as linux above.",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS (Intel, dynamic)",
      "description": "For Intel Macs; see macos-arm64 for Apple Silicon.",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-osx-dynamic" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "android",
      "hidden": true,
      "description": "Builds libmain.so for game/android to package into an APK. Needs ANDROID_NDK_HOME. Static: Android loads one library, and Ogre's render system links into it.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "android-x64",
      "displayName": "Android (x86_64 emulator, static)",
      "inherits": "android",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-android", "ANDROID_ABI": "x86_64" }
    },
    {
      "name": "android-arm64",
      "displayName": "Android (arm64 phones, static)",
      "inherits": "android",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "arm64-android", "ANDROID_ABI": "arm64-v8a" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x64", "configurePreset": "macos-x64" },
    { "name": "android-x64", "configurePreset": "android-x64" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ]
}
